# BotFather token and your own numeric Telegram user ID (comma-separated).
tg_token=
tg_users=
# Groups must be explicitly allowlisted; private chats need only tg_users.
tg_chats=
data_dir=/data
user=zv
pwd=change-this-password
oc_mode=web
oc_port=4096
# Configure providers in OpenCode as usual (opencode.jsonc / opencode auth login).
openai_key=
